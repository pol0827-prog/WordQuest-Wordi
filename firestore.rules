rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.token.email));
    }
    match /students/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid || isTeacher();
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.gift == 0;
      allow update: if (request.auth != null && request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['gift'])) || isTeacher();
    }
    match /vocab/{doc} {
      allow read: if request.auth != null;
      allow write: if isTeacher();
    }
    match /teachers/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
    }
  }
}
