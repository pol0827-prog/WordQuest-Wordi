rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 교사 계정 (이메일을 본인 구글 계정으로 바꾸세요. firebase-config.js 와 같아야 해요)
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "teacher@gmail.com";
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 학생 기록: students/{학생 uid}
    match /students/{uid} {
      // 본인 것만 읽기 / 교사는 전체 읽기
      allow read: if isOwner(uid) || isTeacher();

      // 등록: 본인 문서만, 선물 포인트(gift)는 0으로만 시작
      allow create: if isOwner(uid)
                    && request.resource.data.get('gift', 0) == 0;

      // 수정: 본인은 gift(교사 선물 포인트)를 바꿀 수 없음 / 교사는 모두 가능
      allow update: if isTeacher()
                    || (isOwner(uid)
                        && request.resource.data.get('gift', 0) == resource.data.get('gift', 0));

      allow delete: if isTeacher();
    }

    // 교사가 추가한 어휘 목록: vocab/extra
    match /vocab/{docId} {
      allow read: if true;          // 학생 화면에서 불러오기
      allow write: if isTeacher();  // 추가·삭제는 교사만
    }

    // 그 밖의 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
